{
  "name": "@arctura/docs",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "yarn@4.11.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/marcomg-byte/arctura.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./atomics-components.json": "./dist/atomics-components.json",
    "./markdown/*": "./dist/markdown/*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && typedoc --options typedoc.config.mjs && node scripts/enrich-typedoc-properties.mjs && vite build && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "dev": "node scripts/watch-typedoc.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch",
    "typecheck": "tsc -p tsconfig.eslint.json"
  },
  "devDependencies": {
    "@arctura/atomics": "workspace:^",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "4.1.8",
    "eslint": "^9.39.1",
    "jsdom": "^29.1.1",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "4.1.8"
  }
}
